{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlasfind.org/schemas/tool-v1.0.2.json",
  "title": "AtlasFind Tool Record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "slug",
    "name",
    "description",
    "category",
    "subcategory",
    "tags",
    "pricing_type",
    "website",
    "platforms",
    "languages",
    "pros",
    "cons",
    "verification",
    "publication_status",
    "source_references"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "website": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "publication_status": {
      "enum": [
        "published",
        "draft",
        "pending_review",
        "rejected",
        "archived"
      ]
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "date",
        "note"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "partially_verified",
            "pending",
            "rejected"
          ]
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url",
          "checked_at",
          "type",
          "claims",
          "domain"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "checked_at": {
            "type": "string",
            "format": "date"
          },
          "type": {
            "type": "string",
            "enum": [
              "official-homepage",
              "official-pricing",
              "official-documentation",
              "official-support",
              "official-legal",
              "official-security",
              "official-company",
              "official-store",
              "official-repository"
            ]
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "domain": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
