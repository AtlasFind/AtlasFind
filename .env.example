# AtlasFind v0.8.0 local/production configuration
ATLASFIND_ENV=development
ATLASFIND_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ATLASFIND_HTTPS=0
ATLASFIND_TRUST_PROXY=0
ATLASFIND_SITE_URL=http://127.0.0.1:5000
ATLASFIND_DATABASE_PATH=
ATLASFIND_LOGIN_LIMIT=5
ATLASFIND_LOGIN_WINDOW=900
ATLASFIND_DEBUG=0
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=60
PORT=8000

ATLASFIND_CONTACT_EMAIL=atlasfindd@gmail.com
