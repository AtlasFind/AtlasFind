# AtlasFind v1.0.0 local/production configuration
ATLASFIND_ENV=development
ATLASFIND_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ATLASFIND_HTTPS=0
ATLASFIND_TRUST_PROXY=0
ATLASFIND_ALLOWED_HOSTS=127.0.0.1,localhost
ATLASFIND_SITE_URL=http://127.0.0.1:5000
ATLASFIND_DATABASE_PATH=
ATLASFIND_LOGIN_LIMIT=5
ATLASFIND_LOGIN_WINDOW=900
ATLASFIND_DEBUG=0
# Production-only, one-time initial admin bootstrap. Delete these after deployment.
ATLASFIND_BOOTSTRAP_ADMIN_ENABLED=0
ATLASFIND_BOOTSTRAP_ADMIN_USERNAME=
ATLASFIND_BOOTSTRAP_ADMIN_PASSWORD=
# Production-only, one-time password recovery. Delete these after deployment.
ATLASFIND_ADMIN_RESET_ENABLED=0
ATLASFIND_ADMIN_RESET_USERNAME=
ATLASFIND_ADMIN_RESET_PASSWORD=
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=60
GUNICORN_MAX_REQUESTS=1000
PORT=8000

ATLASFIND_CONTACT_EMAIL=atlasfindd@gmail.com
ATLASFIND_SMTP_HOST=smtp.gmail.com
ATLASFIND_SMTP_PORT=465
ATLASFIND_SMTP_USER=atlasfindd@gmail.com
ATLASFIND_SMTP_PASSWORD=
ATLASFIND_SMTP_FROM=AtlasFind <atlasfindd@gmail.com>
ATLASFIND_SMTP_USE_SSL=1
ATLASFIND_RESEND_API_KEY=
ATLASFIND_RESEND_FROM=AtlasFind <hesap@updates.atlasfind.org>
ATLASFIND_GOOGLE_ANALYTICS_ID=G-WSZDHG9CN9
